# Set this in the environment of the ingestion process. This file is a template.
OPENAQ_API_KEY=
# Optional deployment settings; the service listens locally by default.
AIRPREDICT_HOST=127.0.0.1
PORT=8000

# Local administrative mode only; use at least 32 random characters.
AIRPREDICT_ADMIN_TOKEN=
